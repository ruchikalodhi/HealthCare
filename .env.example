# Database Connection URL (PostgreSQL)
# E.g., postgresql://username:password@localhost:5432/healthcare_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare"

# Direct (non-pooled) database connection, used by Prisma for migrations.
# Required by prisma/schema.prisma's `directUrl`. If your provider doesn't
# pool connections separately (e.g. plain local Postgres), this can be the
# same value as DATABASE_URL. If you're on a pooled host (Neon, Supabase,
# PgBouncer), point DATABASE_URL at the pooled connection string and
# DIRECT_URL at the direct one, or `prisma migrate`/`db push` will fail.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/healthcare"

# NextAuth Settings
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="some-random-32-character-secret-key-here-change-me"

# Google Calendar API Credentials (OAuth 2.0)
# See the "Google Calendar Setup" section of README.md for step-by-step
# Google Cloud Console instructions. The redirect URI below is a dedicated
# route (src/app/api/auth/google/callback) — it is NOT the NextAuth
# provider callback path, and must match an "Authorized redirect URI"
# configured on your OAuth client exactly.
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Resend / SMTP Email Credentials
RESEND_API_KEY=""
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@healthalign.com"

# OpenAI API Key — powers the real pre-visit and post-visit LLM summaries
# (src/lib/ai/client.ts, src/lib/ai/summaries.ts). If left unset, the app
# does NOT fail — it automatically falls back to a deterministic,
# rules-based mock generator so local development and demos still work,
# but the AI output will be templated rather than model-generated. Set
# this to exercise the real LLM path.
OPENAI_API_KEY=""

# Redis connection URL — backs the slot-hold locking (src/lib/redis.ts) and
# the BullMQ job queues for email + Google Calendar sync (src/lib/queue/).
# If left unset, the app falls back to an in-process in-memory cache and an
# inline MockQueue, which is fine for a single local `npm run dev` process
# but is NOT safe for anything with more than one server instance — slot
# holds and queued jobs would only be visible to whichever instance handled
# the request. Set this for anything beyond local single-process dev, e.g.
# a free Upstash Redis instance: redis://default:<password>@<host>:<port>
# When set, you must also run the background worker — see the "Step 5:
# Start the Background Worker" section of README.md.
REDIS_URL=""


