# Database Connection URL (PostgreSQL)
# E.g., postgresql://username:password@localhost:5432/healthcare_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare"

# NextAuth Settings
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="some-random-32-character-secret-key-here-change-me"

# Google Calendar API Credentials (OAuth 2.0)
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Resend / SMTP Email Credentials
RESEND_API_KEY=""
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@healthalign.com"

