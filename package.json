{
  "name": "healthcare-appointment-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "18.x"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "msgpackr-extract": true,
    "prisma": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "worker": "ts-node --compiler-options {\"module\":\"CommonJS\"} src/worker.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "googleapis": "^144.0.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.368.0",
    "next": "14.2.35",
    "next-auth": "^4.24.7",
    "nodemailer": "^7.0.13",
    "openai": "^7.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.2",
    "tailwind-merge": "^2.2.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prisma": "^5.12.1",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
